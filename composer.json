{
  "name": "kazcode/universal-storage",
  "description": "Offload WordPress Media Library binaries to Amazon S3, Cloudflare R2, and S3-compatible object storage",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.3",
    "aws/aws-sdk-php": "^3.300"
  },
  "require-dev": {
    "dg/bypass-finals": "^1.11",
    "humbug/php-scoper": "^0.18",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Kazcode\\WpStorage\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kazcode\\WpStorage\\Tests\\": "tests/Unit/",
      "Kazcode\\WpStorage\\Tests\\Support\\": "tests/Support/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist",
    "build:release": "bash build/build-release.sh",
    "build:verify-scoped": "bash build/verify-scoped-build.sh"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.3.0"
    }
  }
}
